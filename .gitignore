# ===== Mặc định chặn mọi thứ ở thư mục gốc, chỉ mở lại những gì cần =====
/*
!/.gitignore
!/.python-version
!/.env.example
!/pyproject.toml
!/uv.lock
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Dockerfile
!/.dockerignore
!/.github/
!/compose.yaml
!/.env.staging.example
!/src/
!/scripts/
!/tests/
!/notebooks/
!/docs/
!/frontend/

# ===== Trong các thư mục được mở: vẫn chặn dữ liệu và file lớn =====
