APP_NAME=ekyc-service
ENV=dev
LOG_LEVEL=INFO
EKYC_API_KEY=change-me
ALLOWED_IMAGE_HOSTS=res.cloudinary.com
MAX_IMAGE_BYTES=8000000
MAX_IMAGE_PIXELS=40000000
FETCH_TIMEOUT_S=10
MAX_CONCURRENT_JOBS=2
JOB_SLOT_TIMEOUT_S=0.5
MIN_IMAGE_SIDE_PX=1000
MIN_BRIGHTNESS=40
BLUR_THRESHOLD=100
GLARE_RATIO_MAX=0.04
# DEPRECATED: unused since c889c11
NAME_MATCH_BLOCK=0.85
# DEPRECATED: unused since c889c11
NAME_MATCH_WARN=0.95
# DEPRECATED: unused since c889c11
FACE_MODEL=ArcFace
# DEPRECATED: unused since c889c11
FACE_DETECTOR=retinaface

DOC_FUZZY_CUTOFF=85
DOC_ACCEPT_SCORE=0.7
DOC_MARGIN=0.3
DOC_SIDE_MARGIN=0.2
DOC_MIN_TEXT_CHARS=30
DOC_MIN_LINE_CONF=0.3
DOC_TOP_FRACTION=0.4
# Danh sách nhận diện ban đầu, không phải nguồn pháp lý; chỉnh theo thẻ thật.
LICENSE_CLASS_CODES=A1,A2,A3,A4,A,B1,B2,B,BE,C1,C,C1E,CE,D1,D2,D,D1E,D2E,DE,E,FB2,FC,FD,FE

OCR_BACKEND=easyocr
OCR_LANGUAGES=vi,en
OCR_MAX_SIDE_PX=1600
OCR_RETRY_ROTATE_180=true
LINE_ROW_TOLERANCE=0.5
LINE_GAP_RATIO=1.5
LABEL_FUZZY_CUTOFF=80
FIELD_GAP_RATIO=2.5
CCCD_MULTILINE_MAX=3
OCR_FIELD_WARN_CONF=0.6
CCCD_TIMEOUT_S=25
TIMEZONE=Asia/Ho_Chi_Minh

# Giá trị khởi điểm, cần chỉnh bằng ảnh thật.
SCRUB_FUZZY_CUTOFF=72
CCCD_COL_SPLIT_RATIO=2.5
CCCD_MIN_ANCHOR_LINES=2
# Để trống dùng mặc định EasyOCR; thử 0.2 nếu box thô gộp hai cột.
OCR_WIDTH_THS=
OCR_REVIEW_CONF=0.85
OCR_REVIEW_CONF_TEXT=0.9

# Mặc định: yolo nếu có checkpoint; opencv là backend legacy.
CARD_DETECTOR_BACKEND=yolo
CARD_YOLO_MODEL_PATH=models/card_pose_v3_best.pt
CARD_YOLO_IMGSZ=640
CARD_YOLO_CONF=0.25
CARD_YOLO_KEYPOINT_CONF=0.4
CARD_YOLO_MIN_AREA_RATIO=0.02
# DEPRECATED: unused since fbe1ec1
CARD_YOLO_BORDER_RATIO=0.003
CARD_ASPECT_RATIO_MIN=1.2
CARD_ASPECT_RATIO_MAX=2.1
# Ngưỡng khởi điểm cho phát hiện nhiều thẻ và fallback xoay; cần chỉnh bằng ảnh thật.
CARD_CONF_PRIMARY=0.25
CARD_CONF_ROTATED=0.35
CARD_ASPECT_MIN=1.15
CARD_ASPECT_MAX=2.3
CARD_DUP_IOU=0.5
CARD_CONTAIN_RATIO=0.8
CARD_SECONDARY_MAX_OVERLAP=0.1
CARD_SECONDARY_MIN_CONF=0.5
CARD_SECONDARY_MIN_AREA_RATIO=0.15
CARD_OUTPUT_WIDTH=1600
CARD_OUTPUT_HEIGHT=1009
# Ngưỡng khởi điểm cho gate hình học trước warp; cần chỉnh bằng ảnh thật.
CARD_MIN_LONG_SIDE_PX=600
CARD_OK_LONG_SIDE_PX=1000
CARD_EDGE_MARGIN_PX=5
QUALITY_PROFILE=strict
EVALUATION_BLUR_THRESHOLD=20
EVALUATION_GLARE_RATIO_MAX=0.15
EVALUATION_MIN_IMAGE_SIDE_PX=320
